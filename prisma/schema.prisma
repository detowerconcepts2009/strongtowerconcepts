generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  email           String        @unique
  phone           String        @unique
  passwordHash    String
  role            UserRole
  status          AccountStatus @default(PENDING)
  verified        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  profileImageUrl String?

  businessPage      BusinessPage?
  favorites         Favorite[]
  identityDocuments IdentityDocument[]
  listings          Listing[]
  notifications     Notification[]
  reviews           Review[]
  sessions          Session[]
  wallet            Wallet?
  orders            Order[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IdentityDocument {
  id                 String               @id @default(cuid())
  userId             String
  documentType       IdentityDocumentType
  documentNumber     String?
  fileUrl            String
  verificationStatus VerificationStatus   @default(PENDING)
  rejectionReason    String?
  uploadedAt         DateTime             @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([uploadedAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String                  @id @default(cuid())
  walletId  String
  reference String                  @unique
  type      WalletTransactionType
  status    WalletTransactionStatus
  amount    Decimal
  createdAt DateTime                @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model BusinessPage {
  id                 String             @id @default(cuid())
  ownerId            String             @unique
  businessName       String
  slug               String             @unique
  businessType       BusinessType
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  verificationStatus VerificationStatus @default(PENDING)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Listing {
  id          String        @id @default(cuid())
  ownerId     String
  listingType ListingType
  status      ListingStatus @default(PENDING)
  title       String
  slug        String        @unique
  description String
  price       Decimal
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  favorites Favorite[]
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images    ListingImage[]
  property  Property?
  reviews   Review[]
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  imageUrl  String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Review {
  id         String   @id @default(cuid())
  listingId  String
  reviewerId String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([reviewerId])
  @@index([rating])
  @@index([createdAt])
  @@index([listingId, createdAt])
}

model Property {
  id        String           @id @default(cuid())
  listingId String           @unique
  category  PropertyCategory
  purpose   PropertyPurpose
  state     String
  city      String
  address   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  listing     Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  documents   PropertyDocument[]
  features    PropertyFeature[]
  inspections PropertyInspection[]
}

model PropertyFeature {
  id         String  @id @default(cuid())
  propertyId String
  name       String
  value      String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyDocument {
  id         String  @id @default(cuid())
  propertyId String
  title      String
  fileUrl    String
  verified   Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyInspection {
  id             String   @id @default(cuid())
  propertyId     String
  customerName   String
  inspectionDate DateTime
  status         String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([inspectionDate])
}

model CatalogueProduct {
  id          String               @id @default(cuid())
  productType CatalogueProductType
  name        String
  description String?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  price       Decimal?

  images     CatalogueProductImage[]
  orderItems OrderItem[]

  @@index([productType])
  @@index([active])
}

model CatalogueProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product CatalogueProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  customerFirstName String
  customerLastName  String
  customerEmail     String
  customerPhone     String
  deliveryAddress   String
  deliveryCity      String
  deliveryState     String
  customerNotes     String?
  subtotal          Decimal
  totalAmount       Decimal
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  catalogueProductId String?
  productName        String
  productType        String
  model              String?
  lengthInches       Float?
  widthInches        Float?
  thicknessInches    Float?
  unitPrice          Decimal
  quantity           Int
  lineTotal          Decimal
  createdAt          DateTime @default(now())

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogueProduct CatalogueProduct? @relation(fields: [catalogueProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([catalogueProductId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CatalogueProductType {
  MATTRESS
  PILLOW
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CUSTOMER
  PROPERTY_OWNER
  REALTOR
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityDocumentType {
  NIN
  DRIVERS_LICENSE
  INTERNATIONAL_PASSPORT
  VOTERS_CARD
  CAC_DOCUMENT
}

enum WalletTransactionType {
  DEPOSIT
  PAYMENT
  COMMISSION
  REFUND
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  WALLET
  PAYMENT
  PROPERTY
  INSPECTION
  VERIFICATION
  SECURITY
  PROMOTION
}

enum BusinessType {
  PROPERTY
  GENERAL
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
  ARCHIVED
}

enum ListingType {
  PROPERTY
  VEHICLE
  FURNITURE
  PRODUCT
  SERVICE
  EDUCATION
}

enum PropertyCategory {
  LAND
  HOUSE
  APARTMENT
  OFFICE
  SHOP
  WAREHOUSE
  HOTEL
  COMMERCIAL
}

enum PropertyPurpose {
  SALE
  RENT
  SHORTLET
}
